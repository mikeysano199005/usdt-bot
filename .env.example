# ─────────────────────────────────────────────────
# Bank-SMS-to-email payment verification (IMAP)
# Leave IMAP_HOST blank to disable the poller entirely.
# For Gmail: host=imap.gmail.com, port=993, password = 16-char App Password.
# ─────────────────────────────────────────────────
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_USER=yourbotpayments@gmail.com
IMAP_PASSWORD=your_16_char_app_password
IMAP_POLL_INTERVAL_MS=30000

# MacroDroid -> webhook for UPI "received money" notifications.
# Make this a long random string; MacroDroid sends it as the "secret" field.
# Leave blank to disable the webhook entirely.
PAYMENT_WEBHOOK_SECRET=replace_with_a_long_random_secret

