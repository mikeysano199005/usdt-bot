# ─────────────────────────────────────────────────
# PostgreSQL — provided automatically by Railway plugin
# ─────────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@host:5432/dbname

# ─────────────────────────────────────────────────
# Discord Bot
# ─────────────────────────────────────────────────
DISCORD_BOT_TOKEN=your_bot_token_here
DISCORD_CLIENT_ID=your_application_client_id
DISCORD_GUILD_ID=your_server_id
ADMIN_CHANNEL_ID=your_admin_alerts_channel_id

# ─────────────────────────────────────────────────
# Backend (Express API)
# ─────────────────────────────────────────────────
PORT=4000
JWT_SECRET=replace_with_a_very_long_random_string_256_bits
JWT_EXPIRES_IN=8h
UPLOADS_DIR=/app/uploads

# ─────────────────────────────────────────────────
# Admin Panel (Next.js)
# ─────────────────────────────────────────────────
# Public URL of your backend (used by the browser)
NEXT_PUBLIC_API_URL=https://your-backend.railway.app
# Internal URL used by Next.js server-side proxy route
INTERNAL_API_URL=https://your-backend.railway.app
NODE_ENV=production
