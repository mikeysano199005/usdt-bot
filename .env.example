# ─────────────────────────────────────────────────
# PostgreSQL — provided automatically by Railway plugin
# ─────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.xxxx.supabase.co:5432/postgres

# ─────────────────────────────────────────────────
# Discord Bot
# ─────────────────────────────────────────────────
DISCORD_BOT_TOKEN=your_bot_token_here
DISCORD_CLIENT_ID=your_application_client_id
DISCORD_GUILD_ID=your_server_id
ADMIN_CHANNEL_ID=your_admin_alerts_channel_id

# ─────────────────────────────────────────────────
# Backend (Express API)
# ─────────────────────────────────────────────────
PORT=4000
JWT_SECRET=replacewithaverylongrandomstring256bits12312313
JWT_EXPIRES_IN=8h
UPLOADS_DIR=/app/uploads

# ─────────────────────────────────────────────────
# Admin Panel (Next.js)
# ─────────────────────────────────────────────────
# Public URL of your backend (used by the browser)
NEXT_PUBLIC_API_URL=https://usdt-bot-production.up.railway.app
INTERNAL_API_URL=https://usdt-bot-production.up.railway.app

NODE_ENV=production
